# floortint — 環境変数テンプレート
# 実値はこのファイルに書かず、App Service の「環境変数（アプリケーション設定）」
# またはローカル実行時のシェル環境で設定すること。
# 本アプリは外部 API キーを一切必要としない（PDF の解析と画像合成だけで完結する）。

# --- 任意 ---

# 公開ポート（既定 8000。App Service が自動設定する）
# PORT=8000

# アップロード上限 [MB]（平面図・床仕上図の PDF。図面帳は 20〜30MB になることがある。既定 200）
# MAX_UPLOAD_MB=200

# サンプル案件の PDF を置く場所（既定 /app/samples）。PDF が無ければ画面はアップロードのみになる。
# サンプルを使う場合は app/run_cases.py の CASES にファイル名とページ番号を合わせて配置する。
# 図面は社内限の資料なので、社外に見える環境には置かないこと。
# FLOORTINT_SAMPLES=/home/data/floortint_samples

# 一括検証（run_cases.py）の出力先（既定 /tmp/floortint_out）
# FLOORTINT_OUT=/tmp/floortint_out
# 床材写真ライブラリと物件設定の保存先（永続ストレージを当てる。例: /home/data/floortint_library）
# FLOORTINT_LIBRARY=/app/library
